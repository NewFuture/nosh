+#[cfg(test)]
+mod execution_tests {
+    use super::*;
+    use std::sync::atomic::{AtomicI32, Ordering};
+
+    #[test]
+    fn cloned_history_cannot_finish_its_parents_execution() {
+        let result = Arc::new(AtomicI32::new(-1));
+        let recorded = result.clone();
+        let mut history = History {
+            active_input: Some(7),
+            active_completion: Some(Box::new(move |code| {
+                recorded.store(code, Ordering::SeqCst);
+                Ok(())
+            })),
+            replaying: true,
+            recording_suppressed: true,
+            ..Default::default()
+        };
+        history.clone().finish_input_with_status(1).unwrap();
+        assert_eq!(result.load(Ordering::SeqCst), -1);
+        history.finish_input_with_status(0).unwrap();
+        assert_eq!(result.load(Ordering::SeqCst), 0);
+        assert!(history.active_input().is_none());
+        assert!(!history.is_replaying() && !history.recording_suppressed());
+        history.finish_input_with_status(9).unwrap();
+        assert_eq!(result.load(Ordering::SeqCst), 0);
+    }
+
+    #[test]
+    fn a_failed_completion_callback_still_releases_execution_state() {
+        let mut history = History {
+            active_input: Some(7),
+            active_completion: Some(Box::new(|_| {
+                Err(std::io::Error::other("outcome unavailable"))
+            })),
+            replaying: true,
+            ..Default::default()
+        };
+        assert!(history.finish_input_with_status(1).is_err());
+        assert!(history.active_input().is_none());
+        assert!(!history.is_replaying());
+        history.finish_input_with_status(0).unwrap();
+    }
+}
