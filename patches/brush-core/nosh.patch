 use crate::{completion, error, extensions};
 
+#[cfg(feature = "serde")]
+#[derive(serde::Serialize, serde::Deserialize)]
+/// Execution state for an isolated completion host, excluding jobs, history and descriptors.
+pub struct CompletionState {
+    working_dir: std::path::PathBuf,
+    env: crate::env::ShellEnvironment,
+    funcs: crate::functions::FunctionEnv,
+    options: crate::options::RuntimeOptions,
+    aliases: std::collections::HashMap<String, String>,
+    completion_config: completion::Config,
+    program_location_cache: crate::pathcache::PathCache,
+    args: Vec<String>,
+    name: Option<String>,
+    directory_stack: Vec<std::path::PathBuf>,
+    last_exit_status: u8,
+    builtins: std::collections::HashMap<String, bool>,
+    unsupported_process_state: bool,
+    traps: crate::traps::TrapHandlerConfig,
+}
+
 impl<SE: extensions::ShellExtensions> crate::Shell<SE> {
+    /// Expands a completion path without executing command substitutions.
+    pub async fn expand_completion_path(&mut self, input: &str) -> Result<String, error::Error> {
+        let params = self.default_exec_params();
+        crate::expansion::basic_expand_word_with_options(
+            self,
+            &params,
+            input,
+            &crate::expansion::ExpanderOptions {
+                execute_command_substitutions: false,
+                ..Default::default()
+            },
+        )
+        .await
+    }
+
+    /// Borrows completion execution state without copying the environment or function bodies.
+    #[cfg(feature = "serde")]
+    pub fn completion_state(&self) -> impl serde::Serialize + '_ {
+        #[derive(serde::Serialize)]
+        struct View<'a> {
+            working_dir: &'a std::path::Path,
+            env: &'a crate::env::ShellEnvironment,
+            funcs: &'a crate::functions::FunctionEnv,
+            options: &'a crate::options::RuntimeOptions,
+            aliases: &'a std::collections::HashMap<String, String>,
+            completion_config: &'a completion::Config,
+            program_location_cache: &'a crate::pathcache::PathCache,
+            args: &'a [String],
+            name: &'a Option<String>,
+            directory_stack: &'a [std::path::PathBuf],
+            last_exit_status: u8,
+            builtins: std::collections::HashMap<&'a str, bool>,
+            unsupported_process_state: bool,
+            traps: &'a crate::traps::TrapHandlerConfig,
+        }
+        View {
+            working_dir: &self.working_dir,
+            env: &self.env,
+            funcs: &self.funcs,
+            options: &self.options,
+            aliases: &self.aliases,
+            completion_config: &self.completion_config,
+            program_location_cache: &self.program_location_cache,
+            args: &self.args,
+            name: &self.name,
+            directory_stack: &self.directory_stack,
+            last_exit_status: self.last_exit_status,
+            builtins: self
+                .builtins
+                .iter()
+                .map(|(name, reg)| (name.as_str(), reg.disabled))
+                .collect(),
+            unsupported_process_state: self.open_files.iter_fds().any(|(fd, _)| fd > 2),
+            traps: &self.traps,
+        }
+    }
+
+    /// Restores a snapshot into a host with its own builtin implementations and null standard I/O.
+    #[cfg(feature = "serde")]
+    pub fn restore_completion_state(&mut self, state: CompletionState) -> Result<(), error::Error> {
+        if state.unsupported_process_state
+            || state
+                .builtins
+                .keys()
+                .any(|name| !self.builtins.contains_key(name))
+        {
+            return Err(std::io::Error::new(
+                std::io::ErrorKind::Unsupported,
+                "completion snapshot needs custom descriptors or builtin implementations",
+            )
+            .into());
+        }
+        self.working_dir = state.working_dir;
+        self.env = state.env;
+        self.funcs = state.funcs;
+        self.options = state.options;
+        self.options.interactive = false;
+        self.options.enable_job_control = false;
+        self.options.enable_command_history = false;
+        self.options.external_cmd_leads_session = false;
+        self.aliases = state.aliases;
+        self.completion_config = state.completion_config;
+        self.program_location_cache = state.program_location_cache;
+        self.args = state.args;
+        self.name = state.name;
+        self.directory_stack = state.directory_stack;
+        self.last_exit_status = state.last_exit_status;
+        self.traps = state.traps;
+        for (name, registration) in &mut self.builtins {
+            registration.disabled = state.builtins.get(name).copied().unwrap_or(true);
+        }
+        Ok(())
+    }
