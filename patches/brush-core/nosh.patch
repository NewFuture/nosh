+
+    pub(crate) async fn read_limited(&mut self, limit: usize) -> io::Result<String> {
+        use tokio::io::AsyncReadExt;
+        let mut bytes = Vec::new();
+        let mut chunk = [0; 8192];
+        loop {
+            let size = self.0.read(&mut chunk).await?;
+            if size == 0 {
+                break;
+            }
+            if bytes.len() + size > limit {
+                return Err(io::Error::other("completion output limit reached"));
+            }
+            bytes.extend_from_slice(&chunk[..size]);
+        }
+        String::from_utf8(bytes).map_err(io::Error::other)
+    }
