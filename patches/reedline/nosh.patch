+fn tab_columns(position: (u16, u16), columns: u16) -> u16 {
+    let column = if position.1 >= columns.max(1) {
+        0
+    } else {
+        position.1
+    };
+    8 - column % 8
+}
+
+/// Walk every painted span of one source grapheme; tab cells may cross rows.
+pub(crate) fn walk_grapheme(
+    mut position: (u16, u16),
+    grapheme: &str,
+    columns: u16,
+    mut visit: impl FnMut((u16, u16), u16, &str),
+) -> (u16, u16) {
+    let columns = columns.max(1);
+    if grapheme == "\t" {
+        for _ in 0..tab_columns(position, columns) {
+            let (at, width) = advance_grapheme(position, " ", columns);
+            visit(at, width, " ");
+            position = (at.0, at.1.saturating_add(width));
+        }
+    } else {
+        let (at, width) = advance_grapheme(position, grapheme, columns);
+        visit(at, width, grapheme);
+        position = (at.0, at.1.saturating_add(width));
+    }
+    position
+}
+
+/// Expand only visible tabs in a painting copy, leaving ANSI and source untouched.
+pub(crate) fn expand_tabs<'a>(
+    text: &'a str,
+    position: &mut (u16, u16),
+    columns: u16,
+) -> Cow<'a, str> {
+    if !text.contains('\t') {
+        for grapheme in strip_ansi(text).graphemes(true) {
+            *position = walk_grapheme(*position, grapheme, columns, |_, _, _| {});
+        }
+        return Cow::Borrowed(text);
+    }
+    let mapped = display_text(text);
+    let mut output = String::new();
+    let mut previous = 0;
+    for (index, grapheme) in mapped.text.grapheme_indices(true) {
+        if grapheme == "\t" {
+            let end = mapped.ends[index];
+            output.push_str(&text[previous..end - 1]);
+            output.push_str(&" ".repeat(usize::from(tab_columns(*position, columns))));
+            previous = end;
+        }
+        *position = walk_grapheme(*position, grapheme, columns, |_, _, _| {});
+    }
+    if previous == 0 {
+        Cow::Borrowed(text)
+    } else {
+        output.push_str(&text[previous..]);
+        Cow::Owned(output)
+    }
+}
