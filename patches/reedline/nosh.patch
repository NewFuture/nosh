diff --git a/src/history_panel.rs b/src/history_panel.rs
new file mode 100644
index 0000000000000000000000000000000000000000..a92e91feb465bb53ca00c50396b933217a661177
--- /dev/null
+++ b/src/history_panel.rs
@@ -0,0 +1,593 @@
+use crate::{
+    core_editor::Editor, ColumnarMenu, CompletionResult, EditCommand, HistorySearchStatus, Menu,
+    MenuEvent, Prompt, Span, Suggestion,
+};
+
+const MAX_QUERY_BYTES: usize = 256 * 1024;
+
+/// Stable keyset boundary for a page of contextual history.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct HistoryPanelAnchor {
+    /// Stable ordering value, independent of display text.
+    pub order: i64,
+    /// Stable identity used to break ordering ties.
+    pub id: String,
+}
+
+/// One request to a non-blocking contextual history provider.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct HistoryPanelQuery {
+    /// Literal text to find.
+    pub text: String,
+    /// Whether to limit results to the current project.
+    pub project: bool,
+    /// Optional keyset boundary.
+    pub anchor: Option<HistoryPanelAnchor>,
+    /// Include the boundary record when retaining a selection across scope changes.
+    pub include_anchor: bool,
+    /// Request older rather than newer entries.
+    pub older: bool,
+}
+
+/// One complete, unmodified input and its display metadata.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct HistoryPanelEntry {
+    /// Stable record identity and ordering.
+    pub anchor: HistoryPanelAnchor,
+    /// Text to adopt, never a shortened preview.
+    pub text: String,
+    /// Host-formatted display metadata; never part of the adopted input or its identity.
+    pub label: String,
+    /// Optional plain text location label, truncated from the left when necessary.
+    pub source: String,
+    /// Optional source detail shown for the selected input.
+    pub description: Option<String>,
+}
+
+/// The current response for exactly one query.
+#[derive(Clone, Debug, Default)]
+pub struct HistoryPanelPage {
+    /// Entries ordered oldest to newest.
+    pub entries: Vec<HistoryPanelEntry>,
+    /// Whether another older page exists.
+    pub older: bool,
+    /// Whether another newer page exists.
+    pub newer: bool,
+    /// The provider is still working; entries must not be submitted.
+    pub pending: bool,
+    /// The provider could not complete the query.
+    pub failed: bool,
+    /// Visible scope label.
+    pub title: String,
+    /// Visible error, unavailability or progress information.
+    pub notice: Option<String>,
+    /// Transient query progress, distinct from persistent warnings.
+    pub progress: Option<String>,
+    /// Preferred initial record (for example, the current session's last input).
+    pub preferred: Option<String>,
+}
+
+/// A host-owned history query source. Calls on the editor thread must not block.
+pub trait HistoryPanelProvider: Send {
+    /// Begin a new browsing snapshot.
+    fn begin(&mut self);
+    /// Start or poll the exact request. Completion should signal a repaint.
+    fn query(&mut self, query: &HistoryPanelQuery) -> HistoryPanelPage;
+    /// Cancel any outstanding query without waiting for storage.
+    fn cancel(&mut self);
+}
+
+pub(crate) struct Panel {
+    provider: Box<dyn HistoryPanelProvider>,
+    original: Option<Editor>,
+    pub menu: ColumnarMenu,
+    pub request: HistoryPanelQuery,
+    pub page: HistoryPanelPage,
+    edge: Option<bool>,
+    fallback: Option<(HistoryPanelQuery, HistoryPanelPage)>,
+    exhausted_request: Option<HistoryPanelQuery>,
+    reset_selection: bool,
+    query_error: bool,
+    pub acceptance_notice: Option<String>,
+}
+
+impl Panel {
+    pub fn new(provider: Box<dyn HistoryPanelProvider>, menu: ColumnarMenu) -> Self {
+        Self {
+            provider,
+            original: None,
+            menu: menu
+                .with_columns(1)
+                .with_preserve_case(true)
+                .with_inline_hint()
+                .with_max_rows(std::num::NonZero::new(8).expect("nonzero history viewport")),
+            request: HistoryPanelQuery {
+                text: String::new(),
+                project: false,
+                anchor: None,
+                include_anchor: false,
+                older: true,
+            },
+            page: HistoryPanelPage::default(),
+            edge: None,
+            fallback: None,
+            exhausted_request: None,
+            reset_selection: true,
+            query_error: false,
+            acceptance_notice: None,
+        }
+    }
+
+    pub fn is_active(&self) -> bool {
+        self.menu.is_active()
+    }
+
+    pub fn open(&mut self, editor: &mut Editor, columns: u16) {
+        self.provider.begin();
+        self.menu.handle_menu_event(&MenuEvent::Activate(true));
+        let original = std::mem::take(editor);
+        editor.abbreviation_tracking = original.abbreviation_tracking;
+        editor.set_line_buffer(
+            original.line_buffer().clone(),
+            crate::UndoBehavior::CreateUndoPoint,
+        );
+        editor.clear_selection();
+        self.original = Some(original);
+        let text = editor.get_buffer().to_owned();
+        self.query_error = text.len() > MAX_QUERY_BYTES;
+        let text = if self.query_error {
+            String::new()
+        } else {
+            text
+        };
+        self.request = HistoryPanelQuery {
+            text,
+            project: false,
+            anchor: None,
+            include_anchor: false,
+            older: true,
+        };
+        self.page = HistoryPanelPage::default();
+        self.restart();
+        self.poll(editor, columns);
+    }
+
+    pub fn close(&mut self, editor: &mut Editor) {
+        self.provider.cancel();
+        if let Some(original) = self.original.take() {
+            *editor = original;
+        }
+        self.menu.handle_menu_event(&MenuEvent::Deactivate);
+        self.page = HistoryPanelPage::default();
+        self.query_error = false;
+        self.restart();
+    }
+
+    fn restart(&mut self) {
+        self.request.anchor = None;
+        self.request.include_anchor = false;
+        self.request.older = true;
+        self.edge = None;
+        self.fallback = None;
+        self.exhausted_request = None;
+        self.reset_selection = true;
+        self.acceptance_notice = None;
+    }
+
+    pub fn poll(&mut self, editor: &Editor, columns: u16) {
+        let mut page = if self.query_error {
+            HistoryPanelPage {
+                title: "History (query unavailable)".into(),
+                notice: Some("History query exceeds 256 KiB; edit it or cancel".into()),
+                failed: true,
+                ..Default::default()
+            }
+        } else if self.exhausted_request.is_some() {
+            self.page.clone()
+        } else {
+            self.provider.query(&self.request)
+        };
+        if !page.pending && !page.failed && page.progress.is_none() && page.entries.is_empty() {
+            if let (Some(older), Some((request, mut fallback))) =
+                (self.edge.take(), self.fallback.take())
+            {
+                if older {
+                    fallback.older = false;
+                } else {
+                    fallback.newer = false;
+                }
+                fallback.progress = None;
+                page = fallback;
+                self.exhausted_request = Some(request);
+            } else if self.request.include_anchor {
+                self.request.anchor = None;
+                self.request.include_anchor = false;
+                page = self.provider.query(&self.request);
+            }
+        }
+        let retained = self.menu.selection_id();
+        let initial =
+            (self.reset_selection && !page.pending && (!page.failed || !page.entries.is_empty()))
+                .then(|| match self.edge.take() {
+                    Some(false) => page.entries.first(),
+                    Some(true) => page.entries.last(),
+                    None => retained
+                        .as_ref()
+                        .and_then(|id| page.entries.iter().find(|entry| &entry.anchor.id == id))
+                        .or_else(|| {
+                            page.preferred.as_ref().and_then(|id| {
+                                page.entries.iter().find(|entry| &entry.anchor.id == id)
+                            })
+                        })
+                        .or_else(|| page.entries.last()),
+                })
+                .flatten()
+                .map(|entry| entry.anchor.id.clone());
+        let retained = retained.filter(|id| {
+            !self.reset_selection
+                || page.pending
+                || page.entries.iter().any(|entry| &entry.anchor.id == id)
+        });
+        let result = if page.pending {
+            CompletionResult::Pending
+        } else if page.failed && page.entries.is_empty() {
+            CompletionResult::Unavailable {
+                message: page
+                    .notice
+                    .clone()
+                    .unwrap_or_else(|| "History unavailable".into()),
+            }
+        } else {
+            let width = usize::from(columns);
+            let suggestions = page
+                .entries
+                .iter()
+                .map(|entry| {
+                    let label = preview(&entry.label, width / 3);
+                    let source = preview_tail(
+                        &entry.source,
+                        (width / 2).saturating_sub(
+                            unicode_width::UnicodeWidthStr::width(label.as_str())
+                                + usize::from(!label.is_empty()),
+                        ),
+                    );
+                    let description = match (label.is_empty(), source.is_empty()) {
+                        (true, true) => None,
+                        (false, true) => Some(label),
+                        (true, false) => Some(source),
+                        (false, false) => Some(format!("{label} {source}")),
+                    };
+                    Suggestion {
+                        completion_id: Some(entry.anchor.id.clone()),
+                        value: entry.text.clone(),
+                        display_override: Some(preview_match(
+                            &entry.text,
+                            &self.request.text,
+                            (width / 2).saturating_sub(3),
+                        )),
+                        description,
+                        span: Span::new(0, editor.get_buffer().len()),
+                        ..Default::default()
+                    }
+                })
+                .collect::<Vec<_>>();
+            let message = if page.failed {
+                Some(
+                    page.notice
+                        .as_deref()
+                        .unwrap_or("History unavailable; memory matches are selectable"),
+                )
+            } else {
+                page.progress.as_deref()
+            };
+            match message {
+                Some(message) => CompletionResult::Limited {
+                    suggestions: suggestions.into(),
+                    message: message.to_owned(),
+                },
+                None => CompletionResult::fresh(suggestions),
+            }
+        };
+        let range = 0..editor.get_buffer().len();
+        self.menu
+            .update_result(editor, result, std::slice::from_ref(&range), retained);
+        if let Some(id) = initial {
+            self.menu.select(&id);
+        }
+        if !page.pending && (!page.failed || !page.entries.is_empty()) {
+            self.reset_selection = false;
+            self.fallback = None;
+        }
+        self.page = page;
+    }
+
+    pub fn selected(&self) -> Option<&HistoryPanelEntry> {
+        if !self.menu.results_can_be_accepted() {
+            return None;
+        }
+        let id = self.menu.selected_value()?.completion_id.as_ref()?;
+        self.page
+            .entries
+            .iter()
+            .find(|entry| &entry.anchor.id == id)
+    }
+
+    pub fn inline_hint(&self, query: &str, columns: usize) -> String {
+        let Some(entry) = self.selected() else {
+            return String::new();
+        };
+        if let Some(suffix) = entry.text.strip_prefix(query) {
+            if crate::core_editor::ensure_grapheme_boundary_prev(&entry.text, query.len())
+                == query.len()
+            {
+                return preview(suffix, columns);
+            }
+        }
+        const REPLACEMENT: &str = " -> ";
+        if columns <= REPLACEMENT.len() {
+            return String::new();
+        }
+        format!(
+            "{REPLACEMENT}{}",
+            preview_match(&entry.text, query, columns - REPLACEMENT.len())
+        )
+    }
+
+    pub fn no_matches(&self) -> bool {
+        !self.page.pending
+            && !self.page.failed
+            && self.page.progress.is_none()
+            && self.page.entries.is_empty()
+    }
+
+    pub fn refresh_for_acceptance(&mut self, editor: &Editor, columns: u16) {
+        if let Some(request) = self.exhausted_request.take() {
+            self.request = request;
+        }
+        self.poll(editor, columns);
+    }
+
+    pub fn navigate(&mut self, older: bool, editor: &Editor, columns: u16) {
+        self.acceptance_notice = None;
+        self.poll(editor, columns);
+        if self.page.pending {
+            return;
+        }
+        if self.selected().is_none() {
+            if let Some(entry) = self.page.entries.last() {
+                self.menu.select(&entry.anchor.id);
+            }
+            return;
+        }
+        if self.menu.move_selection_bounded(older) {
+            return;
+        }
+        if (older && self.page.older) || (!older && self.page.newer) {
+            let entry = if older {
+                self.page.entries.first()
+            } else {
+                self.page.entries.last()
+            };
+            if let Some(entry) = entry {
+                let request = self
+                    .exhausted_request
+                    .take()
+                    .unwrap_or_else(|| self.request.clone());
+                self.fallback = Some((request, self.page.clone()));
+                self.request.anchor = Some(entry.anchor.clone());
+                self.request.include_anchor = false;
+                self.request.older = older;
+                self.edge = Some(older);
+                self.reset_selection = true;
+                self.poll(editor, columns);
+            }
+        }
+    }
+
+    pub fn switch_scope(&mut self, editor: &Editor, columns: u16) {
+        let selected = self.selected().map(|entry| entry.anchor.clone());
+        self.request.project = !self.request.project;
+        self.restart();
+        self.request.include_anchor = selected.is_some();
+        self.request.anchor = selected;
+        self.poll(editor, columns);
+    }
+
+    pub fn edit(&mut self, editor: &mut Editor, commands: &[EditCommand], columns: u16) {
+        self.acceptance_notice = None;
+        let recovering = self.query_error;
+        self.query_error = false;
+        for command in commands {
+            let added = match command {
+                EditCommand::InsertString(text) => text.len(),
+                EditCommand::InsertChar(ch) => ch.len_utf8(),
+                EditCommand::InsertNewline => 1,
+                _ => 0,
+            };
+            let replaced = editor.get_selection().map_or(0, |(start, end)| end - start);
+            if added > 0
+                && editor
+                    .get_buffer()
+                    .len()
+                    .saturating_sub(replaced)
+                    .saturating_add(added)
+                    > MAX_QUERY_BYTES
+            {
+                self.query_error = true;
+                self.poll(editor, columns);
+                return;
+            }
+            editor.run_edit_command(command);
+        }
+        if editor.get_buffer().len() > MAX_QUERY_BYTES {
+            self.query_error = true;
+            self.poll(editor, columns);
+            return;
+        }
+        let text = editor.get_buffer().to_owned();
+        if text != self.request.text || recovering {
+            self.request.text = text;
+            self.restart();
+            self.poll(editor, columns);
+        }
+    }
+
+    pub fn status(&self) -> HistorySearchStatus<'_> {
+        let notice = if self.page.failed {
+            self.page.notice.as_deref().or(Some("History unavailable"))
+        } else {
+            self.acceptance_notice
+                .as_deref()
+                .or_else(|| {
+                    (!self.page.pending
+                        && !self.page.entries.is_empty()
+                        && self.selected().is_none())
+                    .then_some("History selection unavailable; navigate to select")
+                })
+                .or(self.page.notice.as_deref())
+        };
+        HistorySearchStatus {
+            title: &self.page.title,
+            notice,
+            progress: self
+                .page
+                .progress
+                .as_deref()
+                .or_else(|| self.page.pending.then_some("Searching history...")),
+            description: self
+                .selected()
+                .and_then(|entry| entry.description.as_deref()),
+            failed: self.page.failed,
+            no_matches: self.no_matches(),
+            can_navigate: !self.page.pending
+                && !self.page.entries.is_empty()
+                && (self.selected().is_none()
+                    || self.page.entries.len() > 1
+                    || self.page.older
+                    || self.page.newer),
+        }
+    }
+
+    pub fn update_message(&mut self, prompt: &dyn Prompt, columns: u16, prompt_visible: bool) {
+        let status = self.status();
+        let description = status
+            .description
+            .map(|text| preview_tail(text, usize::from(columns.min(240))));
+        let lines = prompt.render_history_panel_status(
+            HistorySearchStatus {
+                description: description.as_deref(),
+                ..status
+            },
+            self.selected().is_some(),
+            prompt_visible,
+        );
+        self.menu
+            .set_message(&lines.iter().map(String::as_str).collect::<Vec<_>>());
+    }
+}
+
+pub(crate) fn preview(text: &str, columns: usize) -> String {
+    preview_limited(text, columns).0
+}
+
+fn preview_limited(text: &str, columns: usize) -> (String, bool) {
+    use unicode_segmentation::UnicodeSegmentation;
+    use unicode_width::UnicodeWidthStr;
+    if columns == 0 {
+        return (String::new(), !text.is_empty());
+    }
+    let mut safe = String::new();
+    let mut truncated = false;
+    for ch in text.chars() {
+        match ch {
+            '\n' => safe.push_str(" \\n "),
+            '\r' => safe.push_str("\\r"),
+            '\t' => safe.push_str("\\t"),
+            ch if ch.is_control()
+                || matches!(ch, '\u{202a}'..='\u{202e}' | '\u{2066}'..='\u{2069}') =>
+            {
+                safe.push_str(&format!("\\u{{{:x}}}", ch as u32));
+            }
+            ch => safe.push(ch),
+        }
+        if safe.len() > columns.saturating_mul(8).max(256) {
+            truncated = true;
+            break;
+        }
+    }
+    truncated |= safe.width() > columns;
+    let limit = columns.saturating_sub(usize::from(truncated));
+    let mut result = String::new();
+    let mut width = 0;
+    for grapheme in safe.graphemes(true) {
+        let next = grapheme.width();
+        if width + next > limit {
+            break;
+        }
+        result.push_str(grapheme);
+        width += next;
+    }
+    if truncated {
+        result.push('~');
+    }
+    (result, truncated)
+}
+
+pub(crate) fn preview_match(text: &str, query: &str, columns: usize) -> String {
+    use unicode_segmentation::UnicodeSegmentation;
+    use unicode_width::UnicodeWidthStr;
+
+    let (initial, truncated) = preview_limited(text, columns);
+    if !truncated || query.is_empty() || columns < 4 {
+        return initial;
+    }
+    let Some(found) = text.find(query) else {
+        return initial;
+    };
+    if !preview_limited(&text[..found + query.len()], columns - 1).1 {
+        return initial;
+    }
+    let matched = text
+        .grapheme_indices(true)
+        .take_while(|(index, _)| *index <= found)
+        .last()
+        .map_or(0, |(index, _)| index);
+    let context = (columns / 3).min(columns.saturating_sub(preview(query, columns).width() + 2));
+    let mut start = matched;
+    let mut width = 0;
+    for (index, grapheme) in text[..matched].grapheme_indices(true).rev() {
+        let next = preview(grapheme, usize::MAX).width();
+        if width + next > context {
+            break;
+        }
+        width += next;
+        start = index;
+    }
+    if start == 0 {
+        initial
+    } else {
+        format!("~{}", preview(&text[start..], columns - 1))
+    }
+}
+
+pub(crate) fn preview_tail(text: &str, columns: usize) -> String {
+    use unicode_segmentation::UnicodeSegmentation;
+    use unicode_width::UnicodeWidthStr;
+    if columns == 0 {
+        return String::new();
+    }
+    let text = preview(text, text.len().saturating_mul(8).saturating_add(1));
+    if text.width() <= columns {
+        return text;
+    }
+    let mut width = 1;
+    let mut tail = Vec::new();
+    for grapheme in text.graphemes(true).rev() {
+        width += grapheme.width();
+        if width > columns {
+            break;
+        }
+        tail.push(grapheme);
+    }
+    format!("~{}", tail.into_iter().rev().collect::<String>())
+}
