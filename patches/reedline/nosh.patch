+
+impl Write for MappedBytes {
+    fn write(&mut self, bytes: &[u8]) -> io::Result<usize> {
+        let (end, tab) = self.source.get();
+        if tab && bytes == b" " {
+            self.bytes.push(b'\t');
+        } else {
+            self.bytes.extend_from_slice(bytes);
+        }
+        self.ends.resize(self.bytes.len(), end);
+        Ok(bytes.len())
+    }
+
+    fn flush(&mut self) -> io::Result<()> {
+        Ok(())
+    }
+}
