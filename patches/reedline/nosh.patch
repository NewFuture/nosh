+impl HistoryPanelProvider for PagedSource {
+    fn begin(&mut self) {}
+    fn cancel(&mut self) {}
+
+    fn query(&mut self, query: &HistoryPanelQuery) -> HistoryPanelPage {
+        let mut entries = (0..10)
+            .filter(|index| !query.project || index % 2 == 0)
+            .filter(|index| {
+                query.anchor.as_ref().is_none_or(|anchor| {
+                    if query.older {
+                        *index < anchor.order || (query.include_anchor && *index == anchor.order)
+                    } else {
+                        *index > anchor.order || (query.include_anchor && *index == anchor.order)
+                    }
+                })
+            })
+            .collect::<Vec<_>>();
+        if query.older {
+            entries.reverse();
+        }
+        entries.truncate(3);
+        entries.sort();
+        let older = entries.first().is_some_and(|index| *index > 0);
+        let newer = entries.last().is_some_and(|index| *index < 9);
+        HistoryPanelPage {
+            entries: entries
+                .into_iter()
+                .map(|index| HistoryPanelEntry {
+                    anchor: HistoryPanelAnchor {
+                        order: index,
+                        id: format!("id-{index}"),
+                    },
+                    text: "echo duplicate".into(),
+                    label: "command".into(),
+                    source: format!("project-{index}"),
+                    description: None,
+                })
+                .collect(),
+            older,
+            newer,
+            title: "History".into(),
+            ..Default::default()
+        }
+    }
+}
