@@ -0,0 +1,209 @@
+use super::*;
+use crate::{DefaultPrompt, EditContext, PromptViMode, Vi};
+
+struct ContextMode {
+    inner: Box<dyn EditMode>,
+    query: Emacs,
+}
+
+impl EditMode for ContextMode {
+    fn parse_event(&mut self, event: ReedlineRawEvent) -> ReedlineEvent {
+        self.inner.parse_event(event)
+    }
+
+    fn parse_event_with_context(
+        &mut self,
+        event: ReedlineRawEvent,
+        context: EditContext,
+    ) -> ReedlineEvent {
+        if context == EditContext::HistorySearch {
+            self.query.parse_event(event)
+        } else {
+            self.inner.parse_event(event)
+        }
+    }
+
+    fn edit_mode(&self) -> PromptEditMode {
+        self.inner.edit_mode()
+    }
+
+    fn handle_mode_specific_event(&mut self, event: ReedlineEvent) -> EventStatus {
+        self.inner.handle_mode_specific_event(event)
+    }
+}
+
+fn press(code: KeyCode, modifiers: KeyModifiers) -> Event {
+    Event::Key(KeyEvent::new(code, modifiers))
+}
+
+fn text(value: &str) -> Vec<Event> {
+    value
+        .chars()
+        .map(|c| press(KeyCode::Char(c), KeyModifiers::NONE))
+        .collect()
+}
+
+fn editor(vi: bool) -> Reedline {
+    let mut query = crate::Keybindings::new();
+    query.add_binding(KeyModifiers::NONE, KeyCode::Enter, ReedlineEvent::Enter);
+    query.add_binding(
+        KeyModifiers::NONE,
+        KeyCode::Esc,
+        ReedlineEvent::AcceptHistorySearch,
+    );
+    query.add_binding(
+        KeyModifiers::CONTROL,
+        KeyCode::Char('g'),
+        ReedlineEvent::CancelHistorySearch,
+    );
+    let inner: Box<dyn EditMode> = if vi {
+        Box::new(Vi::default())
+    } else {
+        let mut keys = crate::default_emacs_keybindings();
+        keys.add_binding(
+            KeyModifiers::NONE,
+            KeyCode::F(2),
+            ReedlineEvent::ExecuteHostCommand("suggest".into()),
+        );
+        Box::new(Emacs::new(keys))
+    };
+    let mut editor = Reedline::create()
+        .with_contextual_input(true)
+        .with_edit_mode(Box::new(ContextMode {
+            inner,
+            query: Emacs::new(query),
+        }));
+    editor
+        .history_mut()
+        .save(HistoryItem::from_command_line("echo found"))
+        .unwrap();
+    editor.painter.force_prompt_anchored_for_test(0);
+    editor
+}
+
+#[test]
+fn same_batch_search_keys_belong_to_search_and_enter_submits_the_match() {
+    let mut editor = editor(false);
+    editor.replace_buffer("original".into());
+    let mut events = vec![press(KeyCode::Char('r'), KeyModifiers::CONTROL)];
+    events.extend(text("found"));
+    events.push(press(KeyCode::Enter, KeyModifiers::NONE));
+    assert!(matches!(
+        editor.process_input_batch(&DefaultPrompt::default(), events).unwrap(),
+        ControlFlow::Break(Signal::Success(value)) if value == "echo found"
+    ));
+}
+
+#[test]
+fn cancelling_vi_search_restores_original_text_cursor_selection_and_mode() {
+    let mut editor = editor(true);
+    editor.replace_buffer("echo '\u{4e2d} e\u{301}'".into());
+    let _ = editor
+        .process_input_batch(
+            &DefaultPrompt::default(),
+            vec![press(KeyCode::Esc, KeyModifiers::NONE)],
+        )
+        .unwrap();
+    let draft = editor.current_buffer_contents().to_owned();
+    let cursor = editor.current_insertion_point();
+    let selection = editor.current_selection();
+    let mut events = vec![press(KeyCode::Char('?'), KeyModifiers::NONE)];
+    events.extend(text("found"));
+    events.push(press(KeyCode::Char('g'), KeyModifiers::CONTROL));
+    let _ = editor
+        .process_input_batch(&DefaultPrompt::default(), events)
+        .unwrap();
+    assert_eq!(editor.current_buffer_contents(), draft);
+    assert_eq!(editor.current_insertion_point(), cursor);
+    assert_eq!(editor.current_selection(), selection);
+    assert_eq!(
+        editor.prompt_edit_mode(),
+        PromptEditMode::Vi(PromptViMode::Normal)
+    );
+}
+
+#[test]
+fn escape_accepts_without_submitting_and_no_match_enter_keeps_search() {
+    let mut editor = editor(false);
+    editor.replace_buffer("original".into());
+    let mut events = vec![press(KeyCode::Char('r'), KeyModifiers::CONTROL)];
+    events.extend(text("found"));
+    events.push(press(KeyCode::Esc, KeyModifiers::NONE));
+    assert!(matches!(
+        editor
+            .process_input_batch(&DefaultPrompt::default(), events)
+            .unwrap(),
+        ControlFlow::Continue(())
+    ));
+    assert_eq!(editor.current_buffer_contents(), "echo found");
+    let mut events = vec![press(KeyCode::Char('r'), KeyModifiers::CONTROL)];
+    events.extend(text("unmatched_fixture_query"));
+    events.push(press(KeyCode::Enter, KeyModifiers::NONE));
+    let _ = editor
+        .process_input_batch(&DefaultPrompt::default(), events)
+        .unwrap();
+    assert_eq!(editor.input_mode, InputMode::HistorySearch);
+    editor
+        .handle_event(
+            &DefaultPrompt::default(),
+            ReedlineEvent::CancelHistorySearch,
+        )
+        .unwrap();
+    assert_eq!(editor.current_buffer_contents(), "echo found");
+}
+
+#[test]
+fn host_replacement_is_one_edit_and_retained_typeahead_cannot_submit_it() {
+    let mut editor = editor(false);
+    editor.replace_buffer("original".into());
+    editor.run_edit_commands(&[
+        EditCommand::MoveToPosition {
+            position: 2,
+            select: false,
+        },
+        EditCommand::MoveToPosition {
+            position: 5,
+            select: true,
+        },
+    ]);
+    let cursor = editor.current_insertion_point();
+    let selection = editor.current_selection();
+    assert!(selection.is_some());
+    let events = vec![
+        press(KeyCode::F(2), KeyModifiers::NONE),
+        press(KeyCode::Char('!'), KeyModifiers::NONE),
+        press(KeyCode::Enter, KeyModifiers::NONE),
+    ];
+    assert!(matches!(
+        editor.process_input_batch(&DefaultPrompt::default(), events).unwrap(),
+        ControlFlow::Break(Signal::HostCommand(value)) if value == "suggest"
+    ));
+    editor.replace_buffer("\u{4e2d}".into());
+    assert_eq!(editor.current_selection(), None);
+    editor.run_edit_commands(&[EditCommand::Undo]);
+    assert_eq!(editor.current_buffer_contents(), "original");
+    assert_eq!(editor.current_insertion_point(), cursor);
+    assert_eq!(
+        editor.current_selection(),
+        None,
+        "native undo clears the selection"
+    );
+    editor.run_edit_commands(&[EditCommand::Redo]);
+    editor.buffered_input = true;
+    let events = editor.pending_input.drain(..).collect();
+    assert!(matches!(
+        editor
+            .process_input_batch(&DefaultPrompt::default(), events)
+            .unwrap(),
+        ControlFlow::Continue(())
+    ));
+    assert_eq!(editor.current_buffer_contents(), "\u{4e2d}!");
+    editor.buffered_input = false;
+    assert!(matches!(
+        editor.process_input_batch(
+            &DefaultPrompt::default(),
+            vec![press(KeyCode::Enter, KeyModifiers::NONE)]
+        ).unwrap(),
+        ControlFlow::Break(Signal::Success(value)) if value == "\u{4e2d}!"
+    ));
+}
