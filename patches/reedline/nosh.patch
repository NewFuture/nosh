+    use unicode_width::UnicodeWidthStr;
+    assert_eq!(preview("echo", 4), "echo");
+    assert_eq!(preview("中", 2), "中");
+    for (text, query) in [
+        ("prefix-NEEDLE-tail", "NEEDLE"),
+        ("a long shared prefix before 中\u{301} suffix", "\u{301}"),
+        ("a long shared prefix\nbefore 状态 marker", "状态"),
+        ("a long shared prefix before \x1b[31mneedle", "needle"),
+    ] {
+        for columns in 0..80 {
+            let rendered = preview_match(text, query, columns);
+            assert!(rendered.width() <= columns, "{columns}: {rendered:?}");
+            assert!(!rendered.contains('\x1b'), "{rendered:?}");
+            assert!(!rendered.starts_with('\u{301}'), "{rendered:?}");
+            if columns >= 13 {
+                assert!(rendered.contains(query), "{columns}: {rendered:?}");
+            }
+        }
+    }
