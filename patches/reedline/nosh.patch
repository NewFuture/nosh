+/// Read-only interaction facts for the prompt being painted.
+#[derive(Debug, Clone, Copy)]
+pub enum PromptInteraction<'a> {
+    /// Ordinary buffer editing.
+    Editing,
+    /// The active menu, including an opening or provisional menu.
+    Menu {
+        /// Registered menu name.
+        name: &'a str,
+        /// Currently available values, not an estimated total.
+        count: usize,
+        /// Values cannot yet be accepted for the current buffer.
+        provisional: bool,
+    },
+    /// Reverse history search.
+    HistorySearch {
+        /// Current query.
+        term: &'a str,
+        /// Whether an actual result is available to accept.
+        has_match: bool,
+    },
+}
+
+/// A snapshot supplied before rendering the prompt's components.
+#[derive(Debug)]
+pub struct PromptContext<'a> {
+    /// Full editable buffer, excluding hints.
+    pub buffer: &'a str,
+    /// Byte offset of the insertion point.
+    pub cursor: usize,
+    /// Current selection as a byte range, if any.
+    pub selection: Option<(usize, usize)>,
+    /// Physical terminal columns.
+    pub columns: u16,
+    /// Physical terminal rows.
+    pub rows: u16,
+    /// Actual edit mode.
+    pub edit_mode: PromptEditMode,
+    /// Current interaction.
+    pub interaction: PromptInteraction<'a>,
+}
+
 /// API to provide a custom prompt.
 ///
 /// Implementors have to provide [`str`]-based content which will be
 /// displayed before the `LineBuffer` is drawn.
 pub trait Prompt: Send {
+    /// Update cached prompt text from existing facts only. Called on the input
+    /// owner before painting; implementations must not read input or write output.
+    fn update_context(&self, _context: PromptContext<'_>) {}
+
     /// Provide content of the left full prompt
     fn render_prompt_left(&self) -> Cow<'_, str>;
     /// Provide content of the right full prompt
