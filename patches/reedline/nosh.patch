+#[test]
+fn arrows_open_the_history_menu_without_replacing_the_draft() {
+    for opening in [ReedlineEvent::Up, ReedlineEvent::Down] {
+        let mut editor = editor("e");
+        assert!(matches!(event(&mut editor, opening), EventStatus::Handled));
+        assert_eq!(editor.current_buffer_contents(), "e");
+        assert_eq!(editor.input_mode, InputMode::HistorySearch);
+        assert_eq!(
+            editor
+                .history_panel
+                .as_ref()
+                .unwrap()
+                .selected()
+                .unwrap()
+                .text,
+            "echo newest"
+        );
+        event(&mut editor, ReedlineEvent::Up);
+        assert_eq!(
+            editor
+                .history_panel
+                .as_ref()
+                .unwrap()
+                .selected()
+                .unwrap()
+                .text,
+            "echo older"
+        );
+        event(&mut editor, ReedlineEvent::Down);
+        assert_eq!(
+            editor
+                .history_panel
+                .as_ref()
+                .unwrap()
+                .selected()
+                .unwrap()
+                .text,
+            "echo newest"
+        );
+        event(
+            &mut editor,
+            ReedlineEvent::Edit(vec![EditCommand::InsertChar('c')]),
+        );
+        assert_eq!(editor.current_buffer_contents(), "ec");
+        assert_eq!(editor.history_panel.as_ref().unwrap().request.text, "ec");
+        event(&mut editor, ReedlineEvent::CancelHistorySearch);
+        assert_eq!(editor.current_buffer_contents(), "e");
+        assert_eq!(editor.current_insertion_point(), 1);
+    }
+}
