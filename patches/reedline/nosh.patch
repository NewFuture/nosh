+//! Host-owned abbreviation policy and undoable draft provenance.
+
+use std::ops::Range;
+
+/// Whether automatic abbreviation expansion is appropriate for this draft.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub enum InputIntent {
+    /// Ordinary, manually entered input.
+    #[default]
+    Typed,
+    /// Imported text; only an explicit completion may expand it.
+    Imported,
+    /// The user chose to preserve the literal draft.
+    Literal,
+}
+
+/// One exact, non-overlapping replacement in the original input.
+#[derive(Clone, Debug)]
+pub struct AbbreviationEdit {
+    /// UTF-8 byte range in the original input.
+    pub range: Range<usize>,
+    /// Literal text to insert, without evaluating it.
+    pub replacement: String,
+}
+
+/// A bounded, non-blocking host policy. No shell parsing or I/O belongs in this callback.
+pub trait AbbreviationExpander: Send {
+    /// Return replacements for a space boundary or a submitted draft.
+    fn expand(
+        &mut self,
+        input: &str,
+        cursor: usize,
+        submitted: bool,
+        excluded: &[Range<usize>],
+    ) -> Result<Vec<AbbreviationEdit>, String>;
+
+    /// Observe actual draft provenance, including changes without a text change.
+    fn input_changed(&mut self, _input: &str, _intent: InputIntent) {}
+
+    /// Ranges already chosen or expanded in this draft; kept separate from display text.
+    fn expanded_ranges(&mut self, _ranges: &[Range<usize>]) {}
+
+    /// Report an expansion or acceptance failure without blocking editing.
+    fn error(&mut self, _message: &str) {}
+}
+
+#[derive(Clone, Debug, Default, PartialEq, Eq)]
+pub(crate) struct DraftAbbreviations {
+    pub intent: InputIntent,
+    pub expanded: Vec<Range<usize>>,
+    pub generation: u64,
+}
+
+impl DraftAbbreviations {
+    pub fn replace(&mut self, range: Range<usize>, length: usize) {
+        let removed = range.end - range.start;
+        self.expanded.retain_mut(|span| {
+            if range.end <= span.start {
+                span.start = span.start - removed + length;
+                span.end = span.end - removed + length;
+            } else if range.start < span.end {
+                let start = span.start.min(range.start);
+                let end = if span.end >= range.end {
+                    span.end - removed + length
+                } else {
+                    range.start + length
+                };
+                *span = start..end;
+            }
+            span.start < span.end
+        });
+    }
+}
