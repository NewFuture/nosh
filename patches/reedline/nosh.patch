@@ -0,0 +1,379 @@
+use super::utils::{
+    display_text, estimate_required_lines, expand_tabs, line_width, resolve_wrap, strip_ansi,
+    walk_grapheme, wrap_position,
+};
+use std::ops::Range;
+use unicode_segmentation::UnicodeSegmentation;
+
+fn style_controls(text: &str) -> String {
+    let bytes = text.as_bytes();
+    let mut output = String::new();
+    let mut index = 0;
+    while index + 1 < bytes.len() {
+        if bytes[index] != 0x1b {
+            index += 1;
+            continue;
+        }
+        if bytes[index + 1] == b'[' {
+            let Some(end) = bytes[index + 2..]
+                .iter()
+                .position(|byte| (0x40..=0x7e).contains(byte))
+            else {
+                break;
+            };
+            let end = index + end + 3;
+            if bytes[end - 1] == b'm' {
+                output.push_str(&text[index..end]);
+            }
+            index = end;
+        } else if bytes[index + 1] == b']' {
+            let mut end = index + 2;
+            while end < bytes.len()
+                && bytes[end] != 7
+                && !(bytes[end] == 0x1b && bytes.get(end + 1) == Some(&b'\\'))
+            {
+                end += 1;
+            }
+            if end == bytes.len() {
+                break;
+            }
+            end += if bytes[end] == 7 { 1 } else { 2 };
+            if text[index + 2..].starts_with("8;") {
+                output.push_str(&text[index..end]);
+            }
+            index = end;
+        } else {
+            index += 2;
+        }
+    }
+    output
+}
+
+/// Clip by terminal rows without splitting a grapheme or dropping its ANSI style.
+pub(crate) fn clip_display_rows(
+    text: &str,
+    position: &mut (u16, u16),
+    columns: u16,
+    rows: Range<u16>,
+) -> String {
+    let mut expanded_position = *position;
+    let expanded = expand_tabs(text, &mut expanded_position, columns);
+    let text = expanded.as_ref();
+    let mapped = display_text(text);
+    let plain = &mapped.text;
+    let mut selected = None::<Range<usize>>;
+    for (index, grapheme) in plain.grapheme_indices(true) {
+        let old_row = position.0;
+        let mut at = *position;
+        *position = walk_grapheme(*position, grapheme, columns, |point, _, _| at = point);
+        let visible = if grapheme == "\n" {
+            rows.contains(&old_row) && rows.contains(&at.0)
+        } else {
+            rows.contains(&at.0)
+        };
+        if visible {
+            let start = mapped.ends[index] - grapheme.chars().next().unwrap().len_utf8();
+            let end = mapped.ends[index + grapheme.len() - 1];
+            match &mut selected {
+                Some(range) => range.end = end,
+                None => selected = Some(start..end),
+            }
+        }
+    }
+    let mut output = String::new();
+    let mut previous = 0;
+    for (index, character) in plain.char_indices() {
+        let end = mapped.ends[index];
+        let start = end - character.len_utf8();
+        let visible = selected
+            .as_ref()
+            .is_some_and(|range| range.contains(&start));
+        let controls = &text[previous..start];
+        // Hidden rows contribute style, not prompt markers or cursor movement.
+        output.push_str(&if visible {
+            controls.replace('\r', "")
+        } else {
+            style_controls(controls)
+        });
+        if visible {
+            if character == '\n' {
+                output.push('\r');
+            }
+            output.push(character);
+        }
+        previous = end;
+    }
+    output.push_str(&style_controls(&text[previous..]));
+    output
+}
+
+#[derive(Clone, Debug)]
+pub(crate) struct PhysicalRow {
+    text: String,
+    wraps: bool,
+}
+
+#[derive(Clone, Debug)]
+pub(crate) struct RenderedInput {
+    pub(crate) rows: Vec<PhysicalRow>,
+    pub(crate) cursor: (u16, u16),
+}
+
+impl RenderedInput {
+    pub(crate) fn overlay(&mut self, row: u16, column: u16, text: &str) {
+        let mut position = (0, column);
+        let text = expand_tabs(text, &mut position, u16::MAX);
+        for (offset, line) in strip_ansi(&text).split('\n').enumerate() {
+            let row = usize::from(row) + offset;
+            while self.rows.len() <= row {
+                self.rows.push(PhysicalRow {
+                    text: String::new(),
+                    wraps: false,
+                });
+            }
+            let column = if offset == 0 { usize::from(column) } else { 0 };
+            let end = column + line_width(line);
+            let mut prefix = String::new();
+            let mut suffix = String::new();
+            let mut cells = 0;
+            let mut suffix_start = None;
+            for grapheme in self.rows[row].text.graphemes(true) {
+                let width = line_width(grapheme);
+                if cells + width <= column {
+                    prefix.push_str(grapheme);
+                } else if cells >= end {
+                    suffix_start.get_or_insert(cells);
+                    suffix.push_str(grapheme);
+                }
+                cells += width;
+            }
+            prefix.push_str(&" ".repeat(column.saturating_sub(line_width(&prefix))));
+            prefix.push_str(line);
+            if let Some(start) = suffix_start {
+                prefix.push_str(&" ".repeat(start.saturating_sub(end)));
+            }
+            prefix.push_str(&suffix);
+            self.rows[row].text = prefix;
+        }
+    }
+
+    pub(crate) fn with_prefix(mut self, prefix: &[PhysicalRow]) -> Self {
+        self.cursor.1 = self
+            .cursor
+            .1
+            .saturating_add(prefix.len().min(u16::MAX as usize) as u16);
+        self.rows.splice(0..0, prefix.iter().cloned());
+        self
+    }
+
+    pub(crate) fn reflowed(&self, columns: u16) -> Self {
+        let mut groups = vec![String::new()];
+        for (index, row) in self.rows.iter().enumerate() {
+            groups.last_mut().unwrap().push_str(&row.text);
+            if !row.wraps && index + 1 != self.rows.len() {
+                groups.push(String::new());
+            }
+        }
+        Self::new(&groups.join("\r\n"), self.reflow_cursor(columns), columns)
+    }
+
+    pub(crate) fn new(text: &str, cursor: (u16, u16), columns: u16) -> Self {
+        let mut rows = vec![PhysicalRow {
+            text: String::new(),
+            wraps: false,
+        }];
+        let mut position = (0, 0);
+        for grapheme in strip_ansi(text).graphemes(true) {
+            let mut previous_row = position.0;
+            position = walk_grapheme(position, grapheme, columns, |at, _, painted| {
+                if at.0 != previous_row && painted != "\n" {
+                    rows[usize::from(previous_row)].wraps = true;
+                }
+                while rows.len() <= usize::from(at.0) {
+                    rows.push(PhysicalRow {
+                        text: String::new(),
+                        wraps: false,
+                    });
+                }
+                if painted != "\n" {
+                    rows[usize::from(at.0)].text.push_str(painted);
+                }
+                previous_row = at.0;
+            });
+        }
+        // An absolute margin cursor can occupy a separate, empty hard row.
+        while rows.len() <= usize::from(cursor.1) {
+            rows.push(PhysicalRow {
+                text: String::new(),
+                wraps: false,
+            });
+        }
+        Self { rows, cursor }
+    }
+
+    pub(crate) fn reflow_cursor(&self, columns: u16) -> (u16, u16) {
+        let mut group = String::new();
+        let mut base_row = 0u16;
+        for (index, row) in self.rows.iter().enumerate() {
+            if index == usize::from(self.cursor.1) {
+                let mut offset = 0usize;
+                for grapheme in row.text.graphemes(true) {
+                    if offset >= usize::from(self.cursor.0) {
+                        break;
+                    }
+                    group.push_str(grapheme);
+                    offset += line_width(grapheme);
+                }
+                group.push_str(&" ".repeat(usize::from(self.cursor.0).saturating_sub(offset)));
+                let (column, line) = wrap_position([group.as_str()], columns.max(1))
+                    .map(|end| resolve_wrap(end, columns.max(1)))
+                    .unwrap_or((0, 0));
+                return (column, base_row.saturating_add(line));
+            }
+            group.push_str(&row.text);
+            if !row.wraps {
+                base_row = base_row.saturating_add(
+                    estimate_required_lines(&group, columns.max(1))
+                        .max(1)
+                        .min(u16::MAX as usize) as u16,
+                );
+                group.clear();
+            }
+        }
+        (0, base_row)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn tab_spaces_are_clipped_by_physical_row_without_losing_the_style() {
+        let mut position = (0, 0);
+        let output = clip_display_rows("\x1b[31mab\t中x\x1b[0m", &mut position, 5, 1..2);
+        assert_eq!(strip_ansi(&output), "   中");
+        assert_eq!(position, (2, 1));
+        assert!(output.contains("\x1b[31m") && output.ends_with("\x1b[0m"));
+        assert!(!output.contains('\t'));
+    }
+
+    #[test]
+    fn painted_tab_spaces_and_cursor_reflow_like_terminal_cells() {
+        let input = RenderedInput::new("ab\t中x", (1, 2), 5);
+        assert_eq!(
+            input
+                .rows
+                .iter()
+                .map(|row| row.text.as_str())
+                .collect::<Vec<_>>(),
+            ["ab   ", "   中", "x"]
+        );
+        assert!(input.rows[0].wraps && input.rows[1].wraps);
+        assert_eq!(input.reflow_cursor(10), (1, 1));
+        let input = RenderedInput::new("ab\t中x", (3, 1), 5);
+        assert_eq!(input.reflow_cursor(10), (8, 0));
+    }
+
+    #[test]
+    fn tabs_clip_from_nonzero_columns_and_are_not_reinterpreted_after_resize() {
+        let mut position = (2, 5);
+        assert_eq!(clip_display_rows("\tX", &mut position, 20, 2..3), "   X");
+        assert_eq!(position, (2, 9));
+        let input = RenderedInput::new("abc\tz", (9, 0), 10);
+        let resized = input.reflowed(5);
+        assert_eq!(
+            resized
+                .rows
+                .iter()
+                .map(|row| row.text.as_str())
+                .collect::<Vec<_>>(),
+            ["abc  ", "   z"]
+        );
+        assert_eq!(resized.cursor, (4, 1));
+        assert_eq!(resized.reflow_cursor(10), (9, 0));
+    }
+
+    #[test]
+    fn clip_long_line_by_physical_rows() {
+        let text = "0123456789".repeat(100);
+        let mut position = (0, 0);
+        assert_eq!(
+            clip_display_rows(&text, &mut position, 10, 3..5),
+            "01234567890123456789"
+        );
+        assert_eq!(position, (99, 10));
+    }
+
+    #[test]
+    fn clipping_preserves_style_and_wide_graphemes() {
+        let mut position = (0, 0);
+        let output = clip_display_rows("\x1b[31mab中e\u{301}文z\x1b[0m", &mut position, 5, 1..2);
+        assert_eq!(strip_ansi(&output), "文z");
+        assert!(output.starts_with("\x1b[31m"));
+        assert!(output.ends_with("\x1b[0m"));
+    }
+
+    #[test]
+    fn clipping_does_not_emit_a_newline_past_the_viewport() {
+        let mut position = (0, 0);
+        assert_eq!(
+            clip_display_rows("first\r\nsecond\r\nthird", &mut position, 80, 0..2),
+            "first\r\nsecond"
+        );
+    }
+
+    #[test]
+    fn clipping_osc_links_retains_complete_control_sequences() {
+        let mut position = (0, 0);
+        let text = "\x1b]8;;https://example.test\x1b\\abcdefgh\x1b]8;;\x1b\\";
+        let output = clip_display_rows(text, &mut position, 4, 1..2);
+        assert_eq!(strip_ansi(&output), "efgh");
+        assert!(output.starts_with("\x1b]8;;https://example.test\x1b\\"));
+        assert!(output.ends_with("\x1b]8;;\x1b\\"));
+    }
+
+    #[test]
+    fn hidden_prompt_markers_are_not_replayed_as_styles() {
+        let mut position = (0, 0);
+        let text = "\x1b]133;A\x07\x1b[31mfirst\n\x1b]133;B\x07second\x1b[0m";
+        let output = clip_display_rows(text, &mut position, 80, 1..2);
+        assert!(!output.contains("133;A"));
+        assert!(output.contains("133;B"));
+        assert!(output.contains("\x1b[31m"));
+        assert_eq!(strip_ansi(&output), "second");
+    }
+
+    #[test]
+    fn full_margin_cursor_is_not_the_text_end_after_resize() {
+        let painted = RenderedInput::new(&format!("status\r\n{}", "x".repeat(80)), (0, 2), 80);
+        assert_eq!(painted.reflow_cursor(48), (0, 3));
+        let painted = RenderedInput::new(&format!("status\r\n{}", "x".repeat(80)), (75, 1), 80);
+        assert_eq!(painted.reflow_cursor(48), (27, 2));
+    }
+
+    #[test]
+    fn reflow_keeps_hard_newline_separate_from_wrapped_continuation() {
+        let painted = RenderedInput::new("abcdefghijkl", (2, 1), 10);
+        assert_eq!(painted.reflow_cursor(20), (12, 0));
+        let painted = RenderedInput::new("abcdefghij\r\nkl", (2, 1), 10);
+        assert_eq!(painted.reflow_cursor(20), (2, 1));
+    }
+
+    #[test]
+    fn archived_prompt_prefix_is_still_owned_when_it_reappears() {
+        let old = RenderedInput::new(&format!("status\r\n{}", "x".repeat(160)), (75, 2), 80);
+        let narrow = old.reflowed(48);
+        assert_eq!(narrow.cursor, (11, 4));
+        let repainted = RenderedInput::new(&format!("status\r\n{}", "x".repeat(160)), (11, 4), 48)
+            .with_prefix(&narrow.rows[..1]);
+        assert_eq!(repainted.reflow_cursor(80), (75, 3));
+    }
+
+    #[test]
+    fn right_prompt_cells_participate_in_reflow() {
+        let mut painted = RenderedInput::new("status\r\nrl> input", (9, 1), 80);
+        painted.overlay(0, 78, "RP");
+        assert_eq!(painted.reflow_cursor(48), (9, 2));
+    }
+}
