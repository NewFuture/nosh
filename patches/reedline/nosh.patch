+    struct GuardedCompleter {
+        inner: DeferredCompleter,
+        automatic: bool,
+        hooks: Arc<std::sync::Mutex<Vec<&'static str>>>,
+    }
+
+    impl Completer for GuardedCompleter {
+        fn completion_requested(&mut self) {
+            self.automatic = true;
+            self.hooks.lock().unwrap().push("request");
+        }
+
+        fn completion_cancelled(&mut self) {
+            self.automatic = false;
+            self.hooks.lock().unwrap().push("cancel");
+        }
+
+        fn completion_navigated(&mut self) {
+            self.automatic = false;
+            self.hooks.lock().unwrap().push("navigate");
+        }
+
+        fn automatic_completion_allowed(&self) -> bool {
+            self.automatic
+        }
+
+        fn complete(&mut self, line: &str, pos: usize) -> CompletionResult {
+            self.hooks.lock().unwrap().push("query");
+            self.inner.complete(line, pos)
+        }
+
+        fn poll_completion(&mut self) -> CompletionStatus {
+            self.inner.poll_completion()
+        }
+    }
