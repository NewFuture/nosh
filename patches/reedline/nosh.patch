+const PREFIX_MENU: &str = "prefix_menu";
+
+struct PrefixCompleter(Arc<AtomicUsize>);
+
+impl Completer for PrefixCompleter {
+    fn menu_on_edit(&self, line: &str, pos: usize, active_menu: Option<&str>) -> MenuUpdate<'_> {
+        match active_menu {
+            None | Some(PREFIX_MENU)
+                if pos == line.len()
+                    && line
+                        .strip_prefix('#')
+                        .is_some_and(|name| name != "help" && "help".starts_with(name)) =>
+            {
+                MenuUpdate::Show(PREFIX_MENU)
+            }
+            Some(PREFIX_MENU) => MenuUpdate::Close,
+            _ => MenuUpdate::Unchanged,
+        }
+    }
+
+    fn completion_requested(&mut self) {
+        self.0.fetch_add(1, Ordering::SeqCst);
+    }
+
+    fn complete(&mut self, line: &str, pos: usize) -> CompletionResult {
+        assert!(line.starts_with('#') && !line.contains(char::is_whitespace));
+        CompletionResult::fresh(vec![Suggestion {
+            value: "help".into(),
+            span: Span::new(1, pos),
+            append_whitespace: true,
+            ..Suggestion::default()
+        }])
+    }
+}
+
+fn prefix_editor(vi: bool) -> (Reedline, Arc<AtomicUsize>) {
+    let requests = Arc::new(AtomicUsize::new(0));
+    let editor = editor(vi)
+        .with_quick_completions(true)
+        .with_partial_completions(true)
+        .with_menu_submit_protection(true)
+        .with_completer(Box::new(PrefixCompleter(requests.clone())))
+        .with_menu(ReedlineMenu::EngineCompleter(Box::new(
+            ColumnarMenu::default()
+                .with_name(PREFIX_MENU)
+                .with_input_mode(crate::InputMode::FullBuffer),
+        )));
+    (editor, requests)
+}
