+            for delete_forward in [false, true] {
+                let (mut editor, requests) = prefix_editor(vi);
+                let prompt = DefaultPrompt::default();
+                let _ = editor.process_input_batch(&prompt, text(line)).unwrap();
+                assert!(editor.active_menu().is_none(), "{line}");
+                let events = if delete_forward {
+                    vec![
+                        press(KeyCode::Left, KeyModifiers::NONE),
+                        press(KeyCode::Delete, KeyModifiers::NONE),
+                    ]
+                } else {
+                    vec![press(KeyCode::Backspace, KeyModifiers::NONE)]
+                };
+                let _ = editor.process_input_batch(&prompt, events).unwrap();
+                assert_eq!(editor.current_buffer_contents(), &line[..line.len() - 1]);
+                assert!(editor.active_menu().is_some(), "{line}");
+                assert_eq!(requests.load(Ordering::SeqCst), 0);
+            }
+        }
+    }
+}
+
+#[test]
+fn prefix_menu_closes_before_task_text_or_a_fully_typed_command() {
+    for vi in [false, true] {
+        for pasted in [false, true] {
+            let (mut editor, requests) = prefix_editor(vi);
+            let prompt = DefaultPrompt::default();
+            let _ = editor.process_input_batch(&prompt, text("#")).unwrap();
+            assert!(editor.active_menu().is_some());
+            let mut events = if pasted {
+                vec![Event::Paste(" explain this".into())]
+            } else {
+                text(" explain this")
+            };
+            events.push(press(KeyCode::Enter, KeyModifiers::NONE));
+            assert!(matches!(
+                editor.process_input_batch(&prompt, events).unwrap(),
+                ControlFlow::Break(Signal::Success(value)) if value == "# explain this"
+            ));
+            assert_eq!(requests.load(Ordering::SeqCst), 0);
+        }
+        for line in ["#help", "# explain this"] {
+            let (mut editor, requests) = prefix_editor(vi);
+            let mut events = text(line);
+            events.push(press(KeyCode::Enter, KeyModifiers::NONE));
+            assert!(matches!(
+                editor
+                    .process_input_batch(&DefaultPrompt::default(), events)
+                    .unwrap(),
+                ControlFlow::Break(Signal::Success(value)) if value == line
+            ));
+            assert_eq!(requests.load(Ordering::SeqCst), 0);
+        }
+    }
+}
+
+#[test]
+fn prefix_menu_cancellation_is_not_undone_by_repaint_cursor_movement_or_undo() {
+    let (mut editor, requests) = prefix_editor(false);
+    let prompt = DefaultPrompt::default();
+    let _ = editor.process_input_batch(&prompt, text("#")).unwrap();
+    let _ = editor
+        .process_input_batch(&prompt, vec![press(KeyCode::Esc, KeyModifiers::NONE)])
+        .unwrap();
+    assert!(editor.active_menu().is_none());
+    editor.repaint(&prompt).unwrap();
+    let _ = editor
+        .process_input_batch(
+            &prompt,
+            vec![
+                press(KeyCode::Left, KeyModifiers::NONE),
+                press(KeyCode::Right, KeyModifiers::NONE),
+            ],
+        )
+        .unwrap();
+    assert!(editor.active_menu().is_none());
+    let _ = editor.process_input_batch(&prompt, text("x")).unwrap();
+    editor
+        .handle_event(&prompt, ReedlineEvent::Edit(vec![EditCommand::Undo]))
+        .unwrap();
+    assert_eq!(editor.current_buffer_contents(), "#");
+    assert!(editor.active_menu().is_none());
+    assert_eq!(requests.load(Ordering::SeqCst), 0);
+}
+
+#[test]
+fn prefix_menu_does_not_open_during_search_history_host_replacement_or_vi_normal_edits() {
+    let (mut editor, requests) = prefix_editor(false);
+    let prompt = DefaultPrompt::default();
+    editor.replace_buffer("#".into());
+    assert!(editor.active_menu().is_none());
+    editor
+        .history_mut()
+        .save(HistoryItem::from_command_line("#"))
+        .unwrap();
+    editor.replace_buffer(String::new());
+    let _ = editor
+        .process_input_batch(&prompt, vec![press(KeyCode::Up, KeyModifiers::NONE)])
+        .unwrap();
+    assert_eq!(editor.current_buffer_contents(), "#");
+    assert!(editor.active_menu().is_none());
+    editor.replace_buffer("original".into());
+    let mut events = vec![press(KeyCode::Char('r'), KeyModifiers::CONTROL)];
+    events.extend(text("#"));
+    let _ = editor.process_input_batch(&prompt, events).unwrap();
+    assert_eq!(editor.input_mode, InputMode::HistorySearch);
+    assert!(editor.active_menu().is_none());
+    assert_eq!(requests.load(Ordering::SeqCst), 0);
+
+    let (mut editor, requests) = prefix_editor(true);
+    editor.replace_buffer("x".into());
+    let mut events = vec![press(KeyCode::Esc, KeyModifiers::NONE)];
+    events.extend(text("r#"));
+    let _ = editor.process_input_batch(&prompt, events).unwrap();
+    assert_eq!(editor.current_buffer_contents(), "#");
+    assert_eq!(
+        editor.prompt_edit_mode(),
+        PromptEditMode::Vi(PromptViMode::Normal)
+    );
+    assert!(editor.active_menu().is_none());
+    assert_eq!(requests.load(Ordering::SeqCst), 0);
+}
