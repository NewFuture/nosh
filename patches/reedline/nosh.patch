+fn abbreviation_editor(page: HistoryPanelPage) -> Reedline {
+    struct Policy;
+    impl crate::AbbreviationExpander for Policy {
+        fn expand(
+            &mut self,
+            text: &str,
+            cursor: usize,
+            submitted: bool,
+            _: &[std::ops::Range<usize>],
+        ) -> std::result::Result<Vec<crate::AbbreviationEdit>, String> {
+            Ok(if text == "gst" && (submitted || cursor == 3) {
+                vec![crate::AbbreviationEdit {
+                    range: 0..3,
+                    replacement: "git status".into(),
+                }]
+            } else {
+                Vec::new()
+            })
+        }
+    }
+    let mut editor = Reedline::create()
+        .with_edit_mode(Box::<crate::Emacs>::default())
+        .with_abbreviation_expander(Box::new(Policy))
+        .with_history_panel(
+            Box::new(EmptySource(Arc::new(Mutex::new(page)))),
+            ColumnarMenu::default(),
+        );
+    editor.painter.force_prompt_anchored_for_test(0);
+    editor
+}
