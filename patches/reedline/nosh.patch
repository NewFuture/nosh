+    /// sources. Newly opened menus display candidates without inserting them.
+    fn menu_on_edit(&self, _line: &str, _pos: usize, _active_menu: Option<&str>) -> MenuUpdate<'_> {
+        MenuUpdate::Unchanged
+    }
+
