+use super::*;
+use crate::{
+    ColumnarMenu, DefaultPrompt, HistoryPanelAnchor, HistoryPanelEntry, HistoryPanelPage,
+    HistoryPanelProvider, HistoryPanelQuery,
+};
+
+struct Source;
+
+impl HistoryPanelProvider for Source {
+    fn begin(&mut self) {}
+    fn cancel(&mut self) {}
+    fn query(&mut self, query: &HistoryPanelQuery) -> HistoryPanelPage {
+        let entries = [("old", "echo older", true), ("new", "echo newest", false)]
+            .into_iter()
+            .enumerate()
+            .filter(|(_, (_, text, project))| {
+                text.contains(&query.text) && (!query.project || *project)
+            })
+            .map(|(index, (id, text, _))| HistoryPanelEntry {
+                anchor: HistoryPanelAnchor {
+                    order: index as i64,
+                    id: id.into(),
+                },
+                text: text.into(),
+                label: "command".into(),
+                source: "project".into(),
+                description: None,
+            })
+            .collect();
+        HistoryPanelPage {
+            entries,
+            title: "History".into(),
+            ..Default::default()
+        }
+    }
+}
+
+fn editor(text: &str) -> Reedline {
+    let mut editor =
+        Reedline::create().with_history_panel(Box::new(Source), ColumnarMenu::default());
+    editor.painter.force_prompt_anchored_for_test(0);
+    editor
+        .editor
+        .set_buffer(text.into(), UndoBehavior::CreateUndoPoint);
+    editor.editor.move_to_end(false);
+    editor
+}
+
+fn event(editor: &mut Reedline, event: ReedlineEvent) -> EventStatus {
+    editor
+        .handle_event(&DefaultPrompt::default(), event)
+        .unwrap()
+}
