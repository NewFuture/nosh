+    #[test]
+    fn clipping_osc_links_retains_complete_control_sequences() {
+        let mut position = (0, 0);
+        let text = "\x1b]8;;https://example.test\x1b\\abcdefgh\x1b]8;;\x1b\\";
+        let output = clip_display_rows(text, &mut position, 4, 1..2);
+        assert_eq!(strip_ansi(&output), "efgh");
+        assert!(output.starts_with("\x1b]8;;https://example.test\x1b\\"));
+        assert!(output.ends_with("\x1b]8;;\x1b\\"));
+    }
+
+    #[test]
+    fn hidden_prompt_markers_are_not_replayed_as_styles() {
+        let mut position = (0, 0);
+        let text = "\x1b]133;A\x07\x1b[31mfirst\n\x1b]133;B\x07second\x1b[0m";
+        let output = clip_display_rows(text, &mut position, 80, 1..2);
+        assert!(!output.contains("133;A"));
+        assert!(output.contains("133;B"));
+        assert!(output.contains("\x1b[31m"));
+        assert_eq!(strip_ansi(&output), "second");
+    }
+
+    #[test]
+    fn full_margin_cursor_is_not_the_text_end_after_resize() {
+        let painted = RenderedInput::new(&format!("status\r\n{}", "x".repeat(80)), (0, 2), 80);
+        assert_eq!(painted.reflow_cursor(48), (0, 3));
+        let painted = RenderedInput::new(&format!("status\r\n{}", "x".repeat(80)), (75, 1), 80);
+        assert_eq!(painted.reflow_cursor(48), (27, 2));
+    }
+
+    #[test]
+    fn reflow_keeps_hard_newline_separate_from_wrapped_continuation() {
+        let painted = RenderedInput::new("abcdefghijkl", (2, 1), 10);
+        assert_eq!(painted.reflow_cursor(20), (12, 0));
+        let painted = RenderedInput::new("abcdefghij\r\nkl", (2, 1), 10);
+        assert_eq!(painted.reflow_cursor(20), (2, 1));
+    }
+
+    #[test]
+    fn archived_prompt_prefix_is_still_owned_when_it_reappears() {
+        let old = RenderedInput::new(&format!("status\r\n{}", "x".repeat(160)), (75, 2), 80);
+        let narrow = old.reflowed(48);
+        assert_eq!(narrow.cursor, (11, 4));
+        let repainted = RenderedInput::new(&format!("status\r\n{}", "x".repeat(160)), (11, 4), 48)
+            .with_prefix(&narrow.rows[..1]);
+        assert_eq!(repainted.reflow_cursor(80), (75, 3));
+    }
+
+    #[test]
+    fn right_prompt_cells_participate_in_reflow() {
+        let mut painted = RenderedInput::new("status\r\nrl> input", (9, 1), 80);
+        painted.overlay(0, 78, "RP");
+        assert_eq!(painted.reflow_cursor(48), (9, 2));
+    }
+}
