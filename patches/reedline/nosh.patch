+/// Strip ANSI while retaining visible tabs and their original source byte ends.
+pub(crate) fn display_text(text: &str) -> DisplayText {
+    let source = Rc::new(Cell::new((0, false)));
+    let mut parser = strip_ansi_escapes::Writer::new(MappedBytes {
+        source: source.clone(),
+        bytes: Vec::new(),
+        ends: Vec::new(),
+    });
+    for (index, byte) in text.as_bytes().iter().enumerate() {
+        source.set((index + 1, *byte == b'\t'));
+        // A printable placeholder is emitted only in text, never inside CSI/OSC.
+        let printable = if *byte == b'\t' { b' ' } else { *byte };
+        parser
+            .write_all(std::slice::from_ref(&printable))
+            .expect("memory writer");
+        parser.flush().expect("memory writer");
+    }
+    let mapped = parser.into_inner().expect("memory writer");
+    DisplayText {
+        text: String::from_utf8(mapped.bytes).expect("ANSI parser emits UTF-8"),
+        ends: mapped.ends,
+    }
+}
