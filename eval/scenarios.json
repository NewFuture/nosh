{
  "schema_version": 2,
  "seeds": [0, 1, 2, 3, 4],
  "timeout_s": 240,
  "scenarios": [
    {
      "id": "largest-files",
      "title": "Find the three largest files",
      "mode": "repl",
      "fixture": "big",
      "inputs": ["# find the 3 largest files under this directory"],
      "completions": [{"kind": "agent"}],
      "group": "mvp",
      "expect": {"max_steps": 4, "max_confirmations": 0, "response_language": "any", "final_question": "forbid"},
      "approval": "deny",
      "check": "largest"
    },
    {
      "id": "listening-port",
      "title": "Identify the process listening on port 8080",
      "mode": "repl",
      "fixture": "port",
      "inputs": ["# which process is listening on port 8080?"],
      "completions": [{"kind": "agent"}],
      "group": "mvp",
      "expect": {"max_steps": 4, "max_confirmations": 0, "response_language": "any", "final_question": "forbid"},
      "approval": "deny",
      "check": "port"
    },
    {
      "id": "language-lines",
      "title": "Count code lines grouped by language",
      "mode": "repl",
      "fixture": "project",
      "inputs": ["# count the lines of code in this project, grouped by language"],
      "completions": [{"kind": "agent"}],
      "group": "mvp",
      "expect": {"max_steps": 6, "max_confirmations": 0, "response_language": "any", "final_question": "forbid"},
      "approval": "deny",
      "check": "lines"
    },
    {
      "id": "rename-files",
      "title": "Rename txt files with approval",
      "mode": "repl",
      "fixture": "rename",
      "inputs": ["# rename every .txt file in this directory to .md"],
      "completions": [{"kind": "agent"}],
      "group": "mvp",
      "expect": {"max_steps": 6, "max_confirmations": 4, "response_language": "any", "final_question": "forbid"},
      "approval": "rename",
      "check": "rename"
    },
    {
      "id": "chinese-python",
      "title": "List Python files in Chinese",
      "mode": "repl",
      "fixture": "project",
      "inputs": ["# 这个项目里有哪些 Python 文件？"],
      "completions": [{"kind": "agent"}],
      "group": "mvp",
      "expect": {"max_steps": 4, "max_confirmations": 0, "response_language": "zh", "final_question": "forbid"},
      "approval": "deny",
      "check": "python"
    },
    {
      "id": "typo-correction",
      "title": "Correct typos without executing or loading the model",
      "mode": "repl",
      "fixture": "typo",
      "inputs": ["gti status", "pyhton3 --version"],
      "corrections": ["git status", "python3 --version"],
      "completions": [{"kind": "correction"}, {"kind": "correction"}],
      "group": "mvp",
      "expect": {"max_steps": 0, "max_confirmations": 0, "response_language": "not_applicable", "final_question": "not_applicable"},
      "approval": "deny",
      "check": "typos"
    },
    {
      "id": "explain-failure",
      "title": "Explain a failed Python command",
      "mode": "repl",
      "fixture": "failure",
      "inputs": ["python3 broken.py", "#"],
      "completions": [{"kind": "shell", "exit_code": 1, "contains": ["FileNotFoundError"]}, {"kind": "agent"}],
      "group": "mvp",
      "expect": {"max_steps": 6, "max_confirmations": 0, "response_language": "any", "final_question": "forbid"},
      "approval": "deny",
      "check": "failure"
    },
    {
      "id": "summarize-git-log",
      "title": "Summarize piped git history",
      "mode": "agent",
      "fixture": "history",
      "input": "Summarize these eight commits. Mention the feature added by each commit and its component.",
      "stdin_command": ["git", "log", "--stat", "-8"],
      "group": "mvp",
      "expect": {"max_steps": 3, "max_confirmations": 0, "response_language": "any", "final_question": "forbid"},
      "approval": "deny",
      "check": "history"
    },
    {
      "id": "suggest-archive",
      "title": "Suggest a command to archive logs",
      "mode": "suggest",
      "fixture": "logs",
      "input": "compress the logs directory into logs.tar.gz",
      "group": "mvp",
      "expect": {"max_steps": 1, "max_confirmations": 0, "response_language": "not_applicable", "final_question": "not_applicable"},
      "approval": "deny",
      "check": "archive"
    },
    {
      "id": "persistent-cwd",
      "title": "Preserve the agent's changed working directory",
      "mode": "repl",
      "fixture": "big",
      "inputs": ["# change the current directory to data and list the files there"],
      "completions": [{"kind": "agent"}],
      "group": "mvp",
      "expect": {"max_steps": 4, "max_confirmations": 1, "response_language": "any", "final_question": "forbid"},
      "approval": "cwd",
      "check": "cwd"
    },
    {
      "id": "zh-rust-build",
      "title": "Build a Rust project from a short Chinese request",
      "mode": "repl",
      "fixture": "rust",
      "inputs": ["编译"],
      "completions": [{"kind": "agent"}],
      "group": "expanded",
      "approval": "rust-build",
      "check": "rust-build",
      "expect": {"max_steps": 4, "max_confirmations": 1, "response_language": "zh", "final_question": "forbid"}
    },
    {
      "id": "zh-node-build",
      "title": "Build a Node project from a short Chinese request",
      "mode": "repl",
      "fixture": "node",
      "inputs": ["编译"],
      "completions": [{"kind": "agent"}],
      "group": "expanded",
      "approval": "node-build",
      "check": "node-build",
      "expect": {"max_steps": 4, "max_confirmations": 1, "response_language": "zh", "final_question": "forbid"}
    },
    {
      "id": "zh-rust-test",
      "title": "Run the Rust tests",
      "mode": "repl",
      "fixture": "rust",
      "inputs": ["跑测试"],
      "completions": [{"kind": "agent"}],
      "group": "expanded",
      "approval": "rust-test",
      "check": "rust-test",
      "expect": {"max_steps": 4, "max_confirmations": 1, "response_language": "zh", "final_question": "forbid"}
    },
    {
      "id": "zh-node-test",
      "title": "Run the Node tests",
      "mode": "repl",
      "fixture": "node",
      "inputs": ["跑测试"],
      "completions": [{"kind": "agent"}],
      "group": "expanded",
      "approval": "node-test",
      "check": "node-test",
      "expect": {"max_steps": 4, "max_confirmations": 1, "response_language": "zh", "final_question": "forbid"}
    },
    {
      "id": "zh-python-test",
      "title": "Run the Python tests",
      "mode": "repl",
      "fixture": "python",
      "inputs": ["跑测试"],
      "completions": [{"kind": "agent"}],
      "group": "expanded",
      "approval": "python-test",
      "check": "python-test",
      "expect": {"max_steps": 4, "max_confirmations": 1, "response_language": "zh", "final_question": "forbid"}
    },
    {
      "id": "zh-git-diff",
      "title": "Describe staged and unstaged changes",
      "mode": "repl",
      "fixture": "dirty-git",
      "inputs": ["看看改了什么"],
      "completions": [{"kind": "agent"}],
      "group": "expanded",
      "approval": "deny",
      "check": "git-diff",
      "expect": {"max_steps": 3, "max_confirmations": 0, "response_language": "zh", "final_question": "forbid"}
    },
    {
      "id": "zh-git-commit",
      "title": "Commit only the local project changes",
      "mode": "repl",
      "fixture": "dirty-git",
      "inputs": ["提交改动"],
      "completions": [{"kind": "agent"}],
      "group": "expanded",
      "approval": "git-commit",
      "check": "git-commit",
      "expect": {"max_steps": 5, "max_confirmations": 2, "response_language": "zh", "final_question": "forbid"}
    },
    {
      "id": "zh-git-log",
      "title": "Describe the recent commits in Chinese",
      "mode": "repl",
      "fixture": "history",
      "inputs": ["最近的提交"],
      "completions": [{"kind": "agent"}],
      "group": "expanded",
      "approval": "deny",
      "check": "recent-history",
      "expect": {"max_steps": 3, "max_confirmations": 0, "response_language": "zh", "final_question": "forbid"}
    },
    {
      "id": "zh-listening-port",
      "title": "Identify port 8080 without a hash prefix",
      "mode": "repl",
      "fixture": "port",
      "inputs": ["哪个进程占用了 8080"],
      "completions": [{"kind": "agent"}],
      "group": "expanded",
      "approval": "deny",
      "check": "port",
      "expect": {"max_steps": 4, "max_confirmations": 0, "response_language": "zh", "final_question": "forbid"}
    },
    {
      "id": "zh-clean-build",
      "title": "Clean real build artifacts without deleting source",
      "mode": "repl",
      "fixture": "rust-built",
      "inputs": ["清理构建产物"],
      "completions": [{"kind": "agent"}],
      "group": "expanded",
      "approval": "rust-clean",
      "check": "rust-clean",
      "expect": {"max_steps": 3, "max_confirmations": 1, "response_language": "zh", "final_question": "forbid"}
    },
    {
      "id": "zh-tool-versions",
      "title": "Query installed tool versions without approval",
      "mode": "repl",
      "fixture": "python",
      "inputs": ["看看 cargo、node、python3 的版本"],
      "completions": [{"kind": "agent"}],
      "group": "expanded",
      "approval": "deny",
      "check": "versions",
      "expect": {"max_steps": 4, "max_confirmations": 0, "response_language": "zh", "final_question": "forbid"}
    },
    {
      "id": "zh-clarify-task",
      "title": "Clarify a genuinely unspecified request",
      "mode": "repl",
      "fixture": "python",
      "inputs": ["帮我处理一下"],
      "completions": [{"kind": "agent"}],
      "group": "expanded",
      "approval": "deny",
      "check": "clarification",
      "expect": {"max_steps": 2, "max_confirmations": 0, "response_language": "zh", "final_question": "require"}
    },
    {
      "id": "zh-build-failure",
      "title": "Explain a real Rust compiler error",
      "mode": "repl",
      "fixture": "rust-broken",
      "inputs": ["cargo build --offline", "为什么编译失败？请说明原因和修复方法，不要修改文件"],
      "completions": [{"kind": "shell", "exit_code": 101, "contains": ["error[E0308]", "mismatched types"]}, {"kind": "agent"}],
      "group": "expanded",
      "approval": "rust-build",
      "check": "build-failure",
      "expect": {"max_steps": 6, "max_confirmations": 1, "response_language": "zh", "final_question": "forbid"}
    },
    {
      "id": "zh-test-failure",
      "title": "Explain a real unittest assertion failure",
      "mode": "repl",
      "fixture": "python-broken",
      "inputs": ["python3 -m unittest discover -s tests -v", "为什么测试失败？请说明原因和修复方法，不要修改文件"],
      "completions": [{"kind": "shell", "exit_code": 1, "contains": ["AssertionError", "FAILED"]}, {"kind": "agent"}],
      "group": "expanded",
      "approval": "python-test",
      "check": "test-failure",
      "expect": {"max_steps": 6, "max_confirmations": 1, "response_language": "zh", "final_question": "forbid"}
    },
    {
      "id": "zh-port-failure",
      "title": "Explain a real address-in-use failure",
      "mode": "repl",
      "fixture": "port",
      "inputs": ["python3 -m http.server 8080 --bind 127.0.0.1", "为什么启动失败？请说明原因和解决方法，不要修改文件或终止进程"],
      "completions": [{"kind": "shell", "exit_code": 1, "contains": ["Address already in use"]}, {"kind": "agent"}],
      "group": "expanded",
      "approval": "deny",
      "check": "port-failure",
      "expect": {"max_steps": 6, "max_confirmations": 0, "response_language": "zh", "final_question": "forbid"}
    }
  ]
}
